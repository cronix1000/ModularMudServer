# ModularMudServer/.env.example
#
# Copy to `.env` (sibling of this file, NOT committed) and edit values.
# Both `ModularMudServer/.gitignore` and the root `.gitignore` ignore `.env`
# so the populated file stays out of git.
#
# mud-server.exe reads this file via the standard `getenv` path — if you
# prefer setting it in your shell directly, that's fine too.
#
# --- Connecting from localhost to the VPS Postgres ---
#
# There is a single MUD database on the VPS: mud_prod.
#
# The search_path default is set at the role level by
# docker/postgresql/init/00-bootstrap.sh (new installs) and
# 01-search-path.sh (existing installs), so the URL is plain — no
# `?options=...` segment required. Older URLs that include it still work.
#
# Open an SSH tunnel first:
#   ssh -L 5432:127.0.0.1:5432 ubuntu@<vps-host>
# Then set the URL:
#
#   MUD_DATABASE_URL=postgresql://mud_prod:CHANGE_ME@127.0.0.1:5432/mud_prod
#
# Take a snapshot (`/admin/snapshots`) before destructive experimentation.
# On the VPS itself (in docker/.env), the URL uses host `mud-postgres`
# instead of `127.0.0.1` because the container resolves the docker network
# name. See docker/.env.example for the prod connection string.

MUD_DATABASE_URL=postgresql://mud_prod:CHANGE_ME@127.0.0.1:5432/mud_prod

# Local-only Postgres override (optional). Useful when working offline.
# Spin up a sibling container on 127.0.0.1:5432 with the `docker/postgresql`
# compose file plus a `pg.env` that defines a `mud_local` role + db, then
# point the URL here and run `node scripts/migrate.mjs` once.
# MUD_DATABASE_URL=postgresql://mud_local:CHANGE_ME@127.0.0.1:5432/mud_local
